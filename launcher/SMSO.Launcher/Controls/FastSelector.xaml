<UserControl x:Class="SMSO.Launcher.Controls.FastSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:net="clr-namespace:SMSO.Net;assembly=SMSO.Net"
             MinHeight="32"
             Focusable="True">
    <UserControl.Resources>
        <DataTemplate x:Key="WarpCourseItemTemplate" DataType="{x:Type net:WarpCourseListItem}">
            <StackPanel>
                <TextBlock Text="{Binding Group}"
                           Margin="0,6,0,2"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource SmsAccent}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGroupHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayName}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="MainBorder"
                Background="{StaticResource SmsSurfaceAlt}"
                BorderBrush="{StaticResource SmsBorder}"
                BorderThickness="1"
                CornerRadius="8"
                MouseWheel="MainBorder_MouseWheel"
                MouseLeftButtonUp="MainBorder_MouseLeftButtonUp"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="SelectionDisplay"
                                  Margin="8,6,4,6"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  TextElement.Foreground="{StaticResource SmsForeground}"
                                  Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock x:Name="SelectionText"
                           Margin="8,6,4,6"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SmsForeground}"
                           Visibility="Collapsed"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1"
                        Background="{StaticResource SmsControl}"
                        BorderBrush="{StaticResource SmsBorder}"
                        BorderThickness="1,0,0,0">
                    <Path HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource SmsForeground}"/>
                </Border>
            </Grid>
        </Border>

        <Popup x:Name="DropPopup"
               PlacementTarget="{Binding ElementName=MainBorder}"
               Placement="Bottom"
               AllowsTransparency="False"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource SmsPopup}"
                    BorderBrush="{StaticResource SmsBorder}"
                    BorderThickness="1"
                    MinWidth="{Binding ActualWidth, ElementName=MainBorder}">
                <ListBox x:Name="ItemsList"
                         MaxHeight="320"
                         Background="{StaticResource SmsPopup}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ItemsList_SelectionChanged"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SmsSelection}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SmsButton}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
