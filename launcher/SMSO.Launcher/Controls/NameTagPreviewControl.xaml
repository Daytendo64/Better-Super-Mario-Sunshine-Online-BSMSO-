<UserControl x:Class="SMSO.Launcher.Controls.NameTagPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Border CornerRadius="8"
            BorderBrush="{StaticResource SmsBorder}"
            BorderThickness="1"
            ClipToBounds="True"
            Height="56">
        <Grid>
            <Border CornerRadius="7" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0A0A14" Offset="0"/>
                        <GradientStop Color="#FF12101C" Offset="0.45"/>
                        <GradientStop Color="#FF1A0A12" Offset="0.85"/>
                        <GradientStop Color="#FF2A1018" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="220" Height="90"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Opacity="0.2">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#FFEF4444" Offset="0"/>
                                <GradientStop Color="#00EF4444" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Height="28" VerticalAlignment="Bottom" Opacity="0.35">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF0A0610" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxHeight="40"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock x:Name="EmptyHint"
                               Text="Enter a display name above"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SmsForegroundDim}"
                               FontSize="12"/>

                    <StackPanel VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="10,6,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource SmsAccent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live preview"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF"/>
                        </StackPanel>
                        <TextBlock Text="Colors update in-game in real time."
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="10,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
