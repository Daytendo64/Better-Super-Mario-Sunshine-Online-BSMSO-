<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Midnight palette — deep navy-black surfaces, crimson accent -->
    <Color x:Key="SmsMidnight">#080810</Color>
    <Color x:Key="SmsMidnightElevated">#0E0E18</Color>
    <Color x:Key="SmsSurfaceColor">#12121E</Color>
    <Color x:Key="SmsSurfaceAltColor">#181824</Color>
    <Color x:Key="SmsCardColor">#1A1A28</Color>
    <Color x:Key="SmsControlColor">#222233</Color>
    <Color x:Key="SmsBorderColor">#2A2A3D</Color>
    <Color x:Key="SmsBorderGlowColor">#44DC2626</Color>
    <Color x:Key="SmsRedPrimary">#DC2626</Color>
    <Color x:Key="SmsRedBright">#EF4444</Color>
    <Color x:Key="SmsRedDeep">#991B1B</Color>
    <Color x:Key="SmsRedGlow">#33EF4444</Color>

    <SolidColorBrush x:Key="SmsBackground" Color="{StaticResource SmsMidnight}"/>
    <SolidColorBrush x:Key="SmsSurface" Color="{StaticResource SmsSurfaceColor}"/>
    <SolidColorBrush x:Key="SmsSurfaceAlt" Color="{StaticResource SmsSurfaceAltColor}"/>
    <SolidColorBrush x:Key="SmsControl" Color="{StaticResource SmsControlColor}"/>
    <SolidColorBrush x:Key="SmsBorder" Color="{StaticResource SmsBorderColor}"/>
    <SolidColorBrush x:Key="SmsBorderGlow" Color="{StaticResource SmsBorderGlowColor}"/>
    <SolidColorBrush x:Key="SmsForeground" Color="#F2F2FA"/>
    <SolidColorBrush x:Key="SmsForegroundDim" Color="#A8A8BE"/>
    <SolidColorBrush x:Key="SmsForegroundMuted" Color="#808098"/>
    <SolidColorBrush x:Key="SmsAccent" Color="{StaticResource SmsRedBright}"/>
    <SolidColorBrush x:Key="SmsAccentSoft" Color="{StaticResource SmsRedGlow}"/>
    <SolidColorBrush x:Key="SmsStatusOk" Color="#34D399"/>
    <SolidColorBrush x:Key="SmsStatusBad" Color="#F87171"/>
    <SolidColorBrush x:Key="SmsStatusWarn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="SmsButton" Color="{StaticResource SmsRedPrimary}"/>
    <SolidColorBrush x:Key="SmsButtonHover" Color="{StaticResource SmsRedBright}"/>
    <SolidColorBrush x:Key="SmsButtonPressed" Color="{StaticResource SmsRedDeep}"/>
    <SolidColorBrush x:Key="SmsButtonDisabled" Color="#1E1E2A"/>
    <SolidColorBrush x:Key="SmsButtonDisabledText" Color="#55556A"/>
    <SolidColorBrush x:Key="SmsSelection" Color="#3B1515"/>
    <SolidColorBrush x:Key="SmsPopup" Color="{StaticResource SmsSurfaceAltColor}"/>
    <SolidColorBrush x:Key="SmsCard" Color="{StaticResource SmsCardColor}"/>
    <SolidColorBrush x:Key="SmsSecondaryBtnSurface" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="SmsSecondaryBtnSurfaceHover" Color="#28283A"/>

    <LinearGradientBrush x:Key="SmsHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0A14" Offset="0"/>
        <GradientStop Color="#12101A" Offset="0.55"/>
        <GradientStop Color="#180A0E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SmsPrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EF4444" Offset="0"/>
        <GradientStop Color="#B91C1C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SmsWindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#06060E" Offset="0"/>
        <GradientStop Color="#0A0812" Offset="0.55"/>
        <GradientStop Color="#120810" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="SmsAuroraGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#38DC2626" Offset="0"/>
        <GradientStop Color="#18B91C1C" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="SmsAuroraGlowSoft" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#24EF4444" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Typography helpers -->
    <Style x:Key="SmsSectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SmsForegroundDim}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="SmsHintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SmsForegroundMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="SmsStatusPill" TargetType="Border">
        <Setter Property="Background" Value="#181824"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SmsBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SmsCard}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorderGlow}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Modern underline tabs -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource SmsSurface}"
                                BorderBrush="{StaticResource SmsBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="20,0,20,0">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>
                        <Border Grid.Row="1" Background="Transparent" Padding="0,4,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForegroundDim}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="TabBg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="TabIndicator"
                                Height="3"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                CornerRadius="2,2,0,0"
                                Margin="8,0,8,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="TabIndicator" Property="Background" Value="{StaticResource SmsAccent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card-style group boxes -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorderGlow}"/>
        <Setter Property="Background" Value="{StaticResource SmsCard}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="18,14,18,18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Padding="1" CornerRadius="13" BorderBrush="#66EF4444" BorderThickness="1">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#EF4444"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.32"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource SmsAccent}" Margin="0,0,10,0"/>
                                    <ContentPresenter ContentSource="Header"
                                                      TextElement.Foreground="{StaticResource SmsForeground}"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.FontSize="14"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SmsPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SmsPrimaryButtonGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmsDangerButton" TargetType="Button" BasedOn="{StaticResource SmsPrimaryButton}"/>

    <Style x:Key="SmsSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SmsSecondaryBtnSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsSecondaryBtnSurfaceHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SmsBorderGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsControl}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmsRedToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource SmsPrimaryButtonGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#FCA5A5"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmsToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource SmsSecondaryBtnSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsAccent}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SmsButtonHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SmsBorderGlow}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsSecondaryBtnSurfaceHover}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SmsSecondaryButton}"/>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SmsSurfaceAlt}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SmsAccent}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SmsAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource SmsButtonDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmsCompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource SmsAccent}"/>
        <Setter Property="Background" Value="{StaticResource SmsControl}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SmsSurfaceAlt}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="2"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="toggleBorder"
                                            Background="{StaticResource SmsSurfaceAlt}"
                                            BorderBrush="{StaticResource SmsBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Margin="6,4"/>
                                            <Path Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource SmsForegroundDim}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="toggleBorder" Property="Background" Value="{StaticResource SmsControl}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{StaticResource SmsAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="8,4,24,4"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          TextElement.Foreground="{StaticResource SmsForeground}"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="False"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource SmsPopup}"
                                    BorderBrush="{StaticResource SmsBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer x:Name="DropDownScroll"
                                              Focusable="True"
                                              SnapsToDevicePixels="True"
                                              CanContentScroll="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource SmsPopup}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{StaticResource SmsForeground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsSelection}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsButton}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SmsSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SmsSelection}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SmsControl}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource SmsSurfaceAlt}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="6,4">
                        <GridViewRowPresenter TextElement.Foreground="{StaticResource SmsForeground}"
                                              TextElement.FontSize="12"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsSelection}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SmsControl}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource SmsControl}"/>
        <Setter Property="Foreground" Value="{StaticResource SmsForegroundDim}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SmsBorder}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb"
                                                    Background="{StaticResource SmsControl}"
                                                    CornerRadius="4"
                                                    Margin="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{StaticResource SmsAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
