<Window x:Class="SMSO.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SMSO.Launcher.Controls"
        Title="BSMSO — Better Super Mario Sunshine Online"
        Icon="/Assets/bsmso.ico"
        Height="820" Width="1080"
        MinHeight="680" MinWidth="920"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Background="{StaticResource SmsWindowBackdrop}">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="420" Height="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-120,-90,0,0"
                     Fill="{StaticResource SmsAuroraGlowSoft}"
                     Opacity="0.55"/>
            <Ellipse Width="420" Height="280"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-90,-120,0"
                     Fill="{StaticResource SmsAuroraGlowSoft}"
                     Opacity="0.55"/>
            <Ellipse Width="420" Height="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-120,0,0,-90"
                     Fill="{StaticResource SmsAuroraGlowSoft}"
                     Opacity="0.55"/>
            <Ellipse Width="420" Height="280"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-120,-90"
                     Fill="{StaticResource SmsAuroraGlowSoft}"
                     Opacity="0.55"/>
            <Ellipse Width="720" Height="120"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,-50,0,0"
                     Fill="{StaticResource SmsAuroraGlow}"
                     Opacity="0.35"/>
            <Ellipse Width="720" Height="120"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,-50"
                     Fill="{StaticResource SmsAuroraGlow}"
                     Opacity="0.35"/>
            <Ellipse Width="120" Height="720"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Margin="-50,0,0,0"
                     Fill="{StaticResource SmsAuroraGlow}"
                     Opacity="0.3"/>
            <Ellipse Width="120" Height="720"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,-50,0"
                     Fill="{StaticResource SmsAuroraGlow}"
                     Opacity="0.3"/>
        </Grid>

        <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SmsHeaderGradient}" Padding="24,18,24,16">
            <Border BorderBrush="{StaticResource SmsBorderGlow}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="12,8" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#7F1D1D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="BSMSO" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Better Super Mario Sunshine Online" FontSize="9" Foreground="#FFCCCC" Opacity="0.9"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SmsStatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SmsStatusBad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Session" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,8,0" FontSize="11"/>
                                <TextBlock x:Name="StatusBadge" Text="Disconnected" VerticalAlignment="Center" Foreground="{StaticResource SmsStatusBad}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource SmsStatusPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dolphin" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,8,0" FontSize="11"/>
                                    <TextBlock x:Name="DolphinProcessBadge" Text="Not running" VerticalAlignment="Center" Foreground="{StaticResource SmsStatusBad}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SmsStatusPill}" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Link" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,8,0" FontSize="11"/>
                                    <TextBlock x:Name="DolphinLinkBadge" Text="Disconnected" VerticalAlignment="Center" Foreground="{StaticResource SmsStatusBad}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DolphinDetailText"
                                   Text="Launch Dolphin with _BSMSO.kxe installed to enable warps and roster sync."
                                   Style="{StaticResource SmsHintText}"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,0,0"
                                   MaxWidth="420"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" BorderThickness="0" Margin="0,0,0,0">
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,20">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">

                        <GroupBox Header="Player Settings" Padding="14,8,14,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Display name"
                                               Style="{StaticResource SmsSectionLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="UsernameBox"
                                             Grid.Column="1"
                                             MaxLength="16"
                                             Margin="0"/>
                                    <TextBlock x:Name="UsernameCharCount"
                                               Grid.Column="2"
                                               Text="0 / 16 characters"
                                               Foreground="{StaticResource SmsForegroundMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Model"
                                               Style="{StaticResource SmsSectionLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <ComboBox x:Name="MarioModelCombo"
                                              Grid.Column="1"
                                              SelectionChanged="MarioModelCombo_SelectionChanged"
                                              Margin="0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="Nametag colors"
                                           Style="{StaticResource SmsSectionLabel}"
                                           Margin="0,0,0,6"/>

                                <Grid x:Name="NameTagColorRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SmsSurfaceAlt}" CornerRadius="8" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Text" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border x:Name="NameTagTextPreview"
                                                    Grid.Column="1"
                                                    Width="26" Height="26"
                                                    Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource SmsBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="White"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="NameTagTextPreview_MouseLeftButtonUp"
                                                    ToolTip="Click to pick text color"/>
                                            <Button x:Name="PickNameTagTextColorButton" Grid.Column="2" Content="Pick" Click="PickNameTagTextColor_Click" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="R" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagTextRBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="G" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagTextGBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="B" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagTextBBox" Width="34" MaxLength="3" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="NameTagGradientColumn"
                                            Grid.Column="2"
                                            Background="{StaticResource SmsSurfaceAlt}"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Gradient" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border x:Name="NameTagGradientPreview"
                                                    Grid.Column="1"
                                                    Width="26" Height="26"
                                                    Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource SmsBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="#888888"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="NameTagGradientPreview_MouseLeftButtonUp"
                                                    ToolTip="Click to pick gradient bottom color"/>
                                            <Button x:Name="PickNameTagGradientColorButton" Grid.Column="2" Content="Pick" Click="PickNameTagGradientColor_Click" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="R" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagGradientRBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="G" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagGradientGBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="B" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagGradientBBox" Width="34" MaxLength="3" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="NameTagOutlineColumn"
                                            Grid.Column="2"
                                            Background="{StaticResource SmsSurfaceAlt}"
                                            CornerRadius="8"
                                            Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Outline" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border x:Name="NameTagOutlinePreview"
                                                    Grid.Column="1"
                                                    Width="26" Height="26"
                                                    Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource SmsBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="Black"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="NameTagOutlinePreview_MouseLeftButtonUp"
                                                    ToolTip="Click to pick outline color"/>
                                            <Button x:Name="PickNameTagOutlineColorButton" Grid.Column="2" Content="Pick" Click="PickNameTagOutlineColor_Click" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="R" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="0,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagOutlineRBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="G" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagOutlineGBox" Width="34" MaxLength="3" Margin="0"/>
                                                <TextBlock Text="B" VerticalAlignment="Center" Foreground="{StaticResource SmsForegroundDim}" Margin="4,0,3,0" FontSize="12"/>
                                                <TextBox x:Name="NameTagOutlineBBox" Width="34" MaxLength="3" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <ToggleButton x:Name="NameTagGradientToggle"
                                              Content="Gradient text"
                                              Style="{StaticResource SmsRedToggleButton}"
                                              Margin="0,6,0,0"
                                              HorizontalAlignment="Left"
                                              Checked="NameTagGradientToggle_Changed"
                                              Unchecked="NameTagGradientToggle_Changed"/>

                                <controls:NameTagPreviewControl x:Name="LiveNameTagPreview"
                                                                  Margin="0,6,0,0"
                                                                  HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Connection" Padding="14,8,14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Server IP"
                                                   Style="{StaticResource SmsSectionLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="ServerIpBox"
                                                 Grid.Column="1"
                                                 MinWidth="120"
                                                 HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Port" Style="{StaticResource SmsSectionLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ServerPortBox"
                                                 Style="{StaticResource SmsCompactTextBox}"
                                                 Width="84"
                                                 Margin="0,0,14,0"/>
                                        <TextBlock Text="Max players" Style="{StaticResource SmsSectionLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="MaxPlayersCombo"
                                                  Width="88"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="MaxPlayersCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ToggleButton x:Name="ApplyRecommendedDolphinSettingsToggle"
                                                      Content="Apply recommended Dolphin settings"
                                                      Style="{StaticResource SmsRedToggleButton}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,4"
                                                      IsChecked="False"
                                                      Checked="ApplyRecommendedDolphinSettings_Changed"
                                                      Unchecked="ApplyRecommendedDolphinSettings_Changed"
                                                      ToolTip="When on, Launch Dolphin applies the BSMSO performance profile (1× IR, Dual Core, CPU clock 200%, EFB-to-texture off, etc.). When off, restores your backed-up original Dolphin settings. Emulate Disc Speed, CPU clock 200%, and MEM1/MEM2 still stay on either way."/>
                                        <Button x:Name="LaunchDolphinButton" Content="Launch Dolphin" Style="{StaticResource SmsPrimaryButton}" Click="LaunchDolphin_Click" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <Grid Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="HostButton" Content="Host Server" Style="{StaticResource SmsPrimaryButton}" Click="Host_Click" Margin="0,0,8,0"/>
                                                <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource SmsPrimaryButton}" Click="Connect_Click"/>
                                            </StackPanel>
                                            <Border x:Name="GameLinkOverlay"
                                                    Panel.ZIndex="1"
                                                    Background="#E0080810"
                                                    BorderBrush="{StaticResource SmsBorderGlow}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    IsHitTestVisible="True">
                                                <TextBlock Text="Launch Dolphin from this launcher (not a desktop shortcut). Dolphin and the game need to be linked before you can host or connect."
                                                           Style="{StaticResource SmsHintText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="280"
                                                           Margin="16,10"/>
                                            </Border>
                                        </Grid>
                                        <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource SmsDangerButton}" Click="Disconnect_Click" IsEnabled="False" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="Game modules" Padding="14,8,14,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SmsHintText}"
                                               Margin="0,0,0,6"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="Requires an original Super Mario Sunshine copy with nothing installed on it (vanilla dump / clean extract — no prior mods, packs, or BSE). Installs the full Better Sunshine Engine / Kuribo runtime for the Game ISO path in Paths: Kuribo!\System\ (KuriboKernel.bin), BSE-patched sys\main.dol and sys\boot.bin, BetterSunshineEngine.kxe, BetterSunshineMoveset.kxe, and _BSMSO.kxe. Works with an extracted folder or a .iso/.gcm (backs up, then patches the disc in place). Does not support .gcz."/>
                                    <TextBlock x:Name="ModuleInstallStatusText"
                                               Style="{StaticResource SmsHintText}"
                                               Margin="0,0,0,8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="Set Game ISO path to check module install status."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="InstallModulesButton"
                                                Content="Install / patch modules"
                                                Style="{StaticResource SmsPrimaryButton}"
                                                Click="InstallModules_Click"
                                                Margin="0,0,8,0"/>
                                        <Button x:Name="OpenModsFolderButton"
                                                Content="Open Mods folder"
                                                Style="{StaticResource SmsSecondaryButton}"
                                                Click="OpenModsFolder_Click"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </Grid>

                        <GroupBox Header="Paths" Padding="14,8,14,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmsHintText}"
                                           Margin="0,0,0,6"
                                           FontSize="11"
                                           Text="Launch Dolphin from Connection — not a desktop shortcut — so the launcher can link to your game."/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Dolphin"
                                               Style="{StaticResource SmsSectionLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox x:Name="DolphinPathBox"
                                             Grid.Column="1"
                                             Style="{StaticResource SmsCompactTextBox}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Browse…" Click="BrowseDolphin_Click" Padding="10,4"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Game ISO"
                                               Style="{StaticResource SmsSectionLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox x:Name="IsoPathBox"
                                             Grid.Column="1"
                                             Style="{StaticResource SmsCompactTextBox}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Browse…" Click="BrowseIso_Click" Padding="10,4"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ClientTab" Header="Client Actions">
                <Grid Margin="20,12,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="360"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ClipToBounds="True">
                            <GroupBox x:Name="ClientTeleportPanel" Header="Teleport" Padding="14,8,14,10" Margin="0">
                                <StackPanel>
                                    <Grid VerticalAlignment="Center" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="140"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*" MinWidth="160"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Destination" Style="{StaticResource SmsSectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <controls:FastSelector Grid.Column="1" x:Name="ClientLevelCombo" DisplayMemberPath="DisplayName" EnableGroupHeaders="True"/>
                                        <controls:FastSelector Grid.Column="3" x:Name="ClientEpisodeCombo" DisplayMemberPath="DisplayName"/>
                                        <Button Grid.Column="5" x:Name="ClientWarpButton" Content="Warp" Style="{StaticResource SmsPrimaryButton}" Click="ClientWarp_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="ClientWarpStatusText"
                                               Style="{StaticResource SmsHintText}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SmsAccent}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="ClientWorldSyncStatusText"
                                               Style="{StaticResource SmsHintText}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <Border x:Name="ClientTeleportOverlay"
                                    Panel.ZIndex="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="#E0080810"
                                    BorderBrush="{StaticResource SmsBorderGlow}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    IsHitTestVisible="True"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border Width="48" Height="48" CornerRadius="24"
                                            Background="{StaticResource SmsAccentSoft}"
                                            BorderBrush="{StaticResource SmsBorderGlow}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,12">
                                        <TextBlock Text="—" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource SmsAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="ClientTeleportOverlayText"
                                               Text="The host needs to enable client teleporting to use this."
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource SmsForegroundDim}"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               Margin="24,8,24,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <GroupBox Grid.Column="2" x:Name="ClientGameModesPanel" Header="Game Modes" Padding="14,8,14,10">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource SmsSectionLabel}"/>
                                <TextBlock x:Name="ClientGameModeText"
                                           Text="Normal"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SmsForeground}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource SmsHintText}"
                                           Text="View only — the host controls game mode."
                                           Margin="0,0,0,8"/>
                                <StackPanel x:Name="ClientHideSeekPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hiders" Style="{StaticResource SmsSectionLabel}"/>
                                            <Border BorderBrush="{StaticResource SmsBorder}" BorderThickness="1" CornerRadius="6" MinHeight="120">
                                                <ListBox x:Name="ClientHideSeekHidersList"
                                                         Focusable="False"
                                                         IsHitTestVisible="False"
                                                         DisplayMemberPath="Username"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Seekers" Style="{StaticResource SmsSectionLabel}"/>
                                            <Border BorderBrush="{StaticResource SmsBorder}" BorderThickness="1" CornerRadius="6" MinHeight="120">
                                                <ListBox x:Name="ClientHideSeekSeekersList"
                                                         Focusable="False"
                                                         IsHitTestVisible="False"
                                                         DisplayMemberPath="Username"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="ClientHideSeekStatusText"
                                               Style="{StaticResource SmsHintText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <GroupBox Grid.Row="1" Header="Connected Players">
                        <ListView x:Name="ClientRosterList"
                                  MinHeight="340"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Username}" Width="140"/>
                                    <GridViewColumn Header="Level" DisplayMemberBinding="{Binding LevelName}" Width="220"/>
                                    <GridViewColumn Header="Episode" DisplayMemberBinding="{Binding EpisodeName}" Width="220"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="ServerTab" Header="Server Actions">
                <Grid Margin="20,12,20,20">
                    <Grid x:Name="ServerActionsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="360"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <GroupBox Header="Host Teleport">
                            <StackPanel>
                                <Grid Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Destination" Style="{StaticResource SmsSectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <controls:FastSelector Grid.Column="1" x:Name="ServerLevelCombo" DisplayMemberPath="DisplayName" EnableGroupHeaders="True"/>
                                    <controls:FastSelector Grid.Column="3" x:Name="ServerEpisodeCombo" DisplayMemberPath="DisplayName"/>
                                </Grid>
                                <Button Content="Warp Everyone" Style="{StaticResource SmsDangerButton}" Click="ServerWarpAll_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <TextBlock Text="Warp target" Style="{StaticResource SmsSectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <controls:FastSelector x:Name="WarpTargetCombo" Width="200" DisplayMemberPath="Username" Margin="0,0,8,8"/>
                                    <Button Content="Warp Selected" Style="{StaticResource SmsPrimaryButton}" Click="ServerWarpSelected_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="ClientTeleportStatusText"
                                           Style="{StaticResource SmsHintText}"
                                           Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <ToggleButton x:Name="AllowClientTeleportToggle"
                                                  Content="Allow client teleporting"
                                                  Style="{StaticResource SmsRedToggleButton}"
                                                  Margin="0,0,10,4"
                                                  Checked="AllowClientTeleport_Changed"
                                                  Unchecked="AllowClientTeleport_Changed"/>
                                    <ToggleButton x:Name="WorldSyncToggle"
                                                  Content="Sync collectibles"
                                                  Style="{StaticResource SmsRedToggleButton}"
                                                  Margin="0,0,0,4"
                                                  IsChecked="True"
                                                  Checked="WorldSync_Changed"
                                                  Unchecked="WorldSync_Changed"
                                                  ToolTip="Shines and blue coins sync everywhere. Yellow and red coins only sync when players share the same course and episode."/>
                                </WrapPanel>                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Game Modes">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource SmsSectionLabel}"/>
                                <ComboBox x:Name="GameModeCombo" Margin="0,0,0,8"
                                          SelectionChanged="GameModeCombo_SelectionChanged"
                                          PreviewMouseWheel="GameModeCombo_PreviewMouseWheel">
                                    <ComboBoxItem Content="Normal" Tag="Normal"/>
                                    <ComboBoxItem Content="Hide and Seek" Tag="HideSeek"/>
                                </ComboBox>
                                <StackPanel x:Name="HideSeekPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hiders" Style="{StaticResource SmsSectionLabel}"/>
                                            <Border BorderBrush="{StaticResource SmsBorder}" BorderThickness="1" CornerRadius="6" MinHeight="120">
                                                <ListBox x:Name="HideSeekHidersList" AllowDrop="True"
                                                         PreviewMouseLeftButtonDown="HideSeekRoleList_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="HideSeekRoleList_MouseMove"
                                                         DragOver="HideSeekRoleList_DragOver"
                                                         Drop="HideSeekHidersList_Drop"
                                                         DisplayMemberPath="Username"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Seekers" Style="{StaticResource SmsSectionLabel}"/>
                                            <Border BorderBrush="{StaticResource SmsBorder}" BorderThickness="1" CornerRadius="6" MinHeight="120">
                                                <ListBox x:Name="HideSeekSeekersList" AllowDrop="True"
                                                         PreviewMouseLeftButtonDown="HideSeekRoleList_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="HideSeekRoleList_MouseMove"
                                                         DragOver="HideSeekRoleList_DragOver"
                                                         Drop="HideSeekSeekersList_Drop"
                                                         DisplayMemberPath="Username"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="StartStopTagButton" Content="Start Tag"
                                                Style="{StaticResource SmsPrimaryButton}" Margin="0,0,8,0"
                                                Click="StartStopTagButton_Click"/>
                                        <Button x:Name="ResetTagButton" Content="Reset Tag"
                                                Style="{StaticResource SmsSecondaryButton}" Margin="0,0,8,0"
                                                Click="ResetTagButton_Click"/>
                                        <Button x:Name="RandomTagButton" Content="Random Tagger"
                                                Style="{StaticResource SmsPrimaryButton}" Margin="0,0,8,0"
                                                Click="RandomTagButton_Click"
                                                ToolTip="Pick a random connected player as the seeker (never the same one twice in a row)."/>
                                        <Button x:Name="RandomLevelButton" Content="Random Level"
                                                Style="{StaticResource SmsDangerButton}"
                                                Click="RandomLevelButton_Click"
                                                ToolTip="Warp everyone to a random level (Pinna → Park Area Episode 8; Sirena → Episode 5 beach / Noki overrides; never the same level within 5 rounds)."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="HideSeekStatusText" Style="{StaticResource SmsHintText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        </Grid>
                        <GroupBox Grid.Row="1" Header="Connected Players">
                            <ListView x:Name="ServerRosterList"
                                      MinHeight="340"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Username}" Width="120"/>
                                        <GridViewColumn Header="Level" DisplayMemberBinding="{Binding LevelName}" Width="200"/>
                                        <GridViewColumn Header="Episode" DisplayMemberBinding="{Binding EpisodeName}" Width="200"/>
                                        <GridViewColumn Header="Ping" DisplayMemberBinding="{Binding PingMs}" Width="60"/>
                                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </Grid>
                    <Border x:Name="ServerActionsOverlay"
                            Panel.ZIndex="1"
                            Background="#E0080810"
                            BorderBrush="{StaticResource SmsBorderGlow}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="{StaticResource SmsAccentSoft}"
                                    BorderBrush="{StaticResource SmsBorderGlow}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
                                <TextBlock Text="—" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SmsAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Host and connect to enable server actions"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SmsForegroundDim}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Margin="24,8,24,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Help">
                <TabControl Margin="12,8,12,12">
                    <TabItem Header="Start here">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                            <Grid MaxWidth="900">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="You need: BSMSO release zip, Dolphin x64, and a legally owned NTSC-U Super Mario Sunshine disc image (GMSE01). BSE is included in the BSMSO zip."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run FontWeight="SemiBold" Text="BSMSO — "/>
                                            <Hyperlink NavigateUri="https://github.com/Daytendo64/Better-Super-Mario-Sunshine-Online-BSMSO-/releases" RequestNavigate="HelpLink_RequestNavigate">GitHub Releases</Hyperlink>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run FontWeight="SemiBold" Text="Dolphin — "/>
                                            <Hyperlink NavigateUri="https://dolphin-emu.org/download" RequestNavigate="HelpLink_RequestNavigate">dolphin-emu.org</Hyperlink>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="BSE (if needed) — "/>
                                            <Hyperlink NavigateUri="https://github.com/DotKuribo/BetterSunshineEngine/releases" RequestNavigate="HelpLink_RequestNavigate">BSE Releases</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Every session" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="1. Set username, Dolphin path, and game path in Settings."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="2. In Settings → Game modules, click Install / patch modules (extracted folder or .iso/.gcm)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="3. Launch Dolphin — wait for title screen or in-game. (Optional: Connection → Apply recommended Dolphin settings — see Help → Dolphin settings.)"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="4. Host Server or Connect (port 27015)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                   Text="5. Each player runs their own Dolphin. Wait for everyone to finish loading before warping again."/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Game files">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                            <StackPanel MaxWidth="900">
                                <Border Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="You can play from an extracted game folder or a patched .iso/.gcm disc image. Install / patch modules installs Kuribo System (KuriboKernel.bin), BSE-patched main.dol/boot.bin, BetterSunshineEngine.kxe, BetterSunshineMoveset.kxe, and _BSMSO.kxe."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                   Text="Use Settings → Game modules → Install / patch modules. Set Paths → Game ISO to either your extracted folder (or sys\main.dol) or a raw .iso/.gcm file."/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Option A: Extracted folder" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="1. In Dolphin: right-click NTSC-U SMS → Properties → Filesystem → Extract All Files (or Extract Contents)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="2. Confirm the folder has sys\ and files\."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="3. Settings → Paths: set Game ISO to that folder or sys\main.dol."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="4. Settings → Game modules → Install / patch modules (Kuribo System, BSE main.dol/boot.bin, and the .kxe modules)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text="5. Launch Dolphin. Install also patches sys\boot.bin to GMSE90 and boots from the extracted tree."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Option B: Patch .iso / .gcm" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="1. Settings → Paths: set Game ISO to your .iso or .gcm file."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="2. Settings → Game modules → Install / patch modules. The launcher backs up the image, extracts, installs Kuribo System + BSE main.dol/boot.bin + .kxe modules, rebuilds, and replaces the file in place (also ensures game ID GMSE90)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="3. Launch Dolphin with that same disc image."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="4. To update mods later, run Install / patch modules again (another backup is created if .bak already exists)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text=".gcz is not supported — convert to .iso/.gcm in Dolphin first, or use Option A."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Tips" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• NTSC-U Super Mario Sunshine only (GMSE01 → GMSE90)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• Kuribo requires files\Kuribo!\System\KuriboKernel.bin plus BSE-patched sys\main.dol (vanilla SMS cannot load .kxe modules alone)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• BetterSunshineEngine.kxe must load before BetterSunshineMoveset.kxe and _BSMSO.kxe (all in Mods\)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• Fully restart Dolphin after installing or updating modules."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• Do not use SMSCoop with BSMSO."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="• Extracted folders are easier for frequent mod updates; ISO patch is fine if you prefer a single disc file."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                   Text="• Prefer Install / patch modules over manual copy. Manual fallback needs the full BSE zip (Kuribo!, main.dol, boot.bin) plus BetterSunshineEngine.kxe, BetterSunshineMoveset.kxe, and _BSMSO.kxe."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Dolphin settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                            <StackPanel MaxWidth="900">
                                <Border Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Optional on Launch Dolphin" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="Connection has “Apply recommended Dolphin settings.” When that is on, Launch Dolphin writes a performance + stability profile into GMSE90 GameSettings (and matching Dolphin.ini / GFX.ini keys), including Store EFB copies to texture only off. When it is off, your backed-up original settings are restored. Emulate Disc Speed (FastDiscSpeed=False), Emulated CPU Clock Override at 200% (Overclock=2.0), and MEM1/MEM2 always stay on either way. Controls, hotkeys, and your [Gecko] codes are left alone. Other games are not affected."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap">
                                            <Run Text="Based on Dolphin’s "/>
                                            <Hyperlink NavigateUri="https://dolphin-emu.org/docs/guides/performance-guide/" RequestNavigate="HelpLink_RequestNavigate">official performance guide</Hyperlink>
                                            <Run Text=" — tuned for low-end PCs and multiplayer stability."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Core" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Dual Core — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• DSP-HLE — on (fast audio)"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• CPU clock override — on at 200% (recommended profile + always; OverclockEnable=True, Overclock=2.0)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Emulation speed — 100%"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Emulate Disc Speed — on (always; Dolphin INI FastDiscSpeed=False). Applied even when recommended settings are off."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text="• RAM override — MEM1 48 MiB, MEM2 64 MiB (always; required for BSMSO)"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Graphics" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Internal resolution — 1× Native"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• MSAA / SSAA / anisotropic — off"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Shader compilation — Hybrid Ubershaders"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Backend multithreading — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• GPU texture decoding — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text="• VSync — off (avoids half-speed on 30 Hz panels)"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Hacks (safe defaults)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Skip EFB access from CPU — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Store EFB copies to texture only — off"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Store XFB copies to texture only — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Defer EFB copies — on"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text="• Fast depth calculation — on"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                                            BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Not forced" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Graphics backend — leave as-is (Vulkan vs D3D11 depends on your GPU; Intel often prefers D3D11/12)."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="• Controllers / hotkeys — never overwritten."/>
                                            <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                       Text="• If you raise internal resolution for visuals with the recommended profile on, Launch Dolphin will set 1× again next time. Turn the Connection toggle off to keep your own graphics settings."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Online play">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                            <Grid MaxWidth="900">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Radmin VPN (recommended)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run Text="Virtual LAN — no router setup. Install from "/>
                                            <Hyperlink NavigateUri="https://www.radmin-vpn.com/" RequestNavigate="HelpLink_RequestNavigate">radmin-vpn.com</Hyperlink>
                                            <Run Text=" on every PC."/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" Text="Host"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="8,0,0,4"
                                                   Text="Create network → share name, password, and your Radmin IP (26.x.x.x)."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="8,0,0,8"
                                                   Text="Launch Dolphin → Host Server. Allow firewall for BSMSO and Dolphin."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" Text="Clients"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="8,0,0,4"
                                                   Text="Join network → Settings: host's Radmin IP, port 27015."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="8,0,0,0"
                                                   Text="Launch Dolphin → Connect. Usernames must be unique (3–16 letters, numbers, underscore)."/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Port forwarding" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Alternative if you skip VPN: host forwards TCP and UDP 27015 on their router to their PC."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="Share public IP + port 27015. Clients enter that in Settings."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Allow BSMSO.Launcher.exe and Dolphin.exe through Windows Firewall when hosting."/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" FontWeight="SemiBold" Text="Module updates"/>
                                        <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="In Settings → Game modules, click Install / patch modules again (folder or .iso/.gcm), then fully restart Dolphin."/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Support">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                            <StackPanel MaxWidth="900">
                                <Border Background="{StaticResource SmsCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                        BorderBrush="{StaticResource SmsBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Troubleshooting" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SmsAccent}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="• Black screen — check Dolphin log; BSE must load before _BSMSO.kxe in Mods\."/>
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="• Cannot connect — verify host IP (Radmin IP with VPN, public IP with port forward)."/>
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                           Text="• Bridge not attached — launch Dolphin from BSMSO first; load into the game before Host/Connect."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="• Warp blocked — wait until all players finish loading."/>
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="• Name rejected — use 3–16 alphanumeric characters and underscore; no duplicates."/>
                                                <TextBlock Style="{StaticResource SmsHintText}" TextWrapping="Wrap"
                                                           Text="• Antivirus — memory reads for sync can trigger false positives on unsigned builds."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="VersionText" Foreground="{StaticResource SmsForegroundMuted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open Logs Folder" Click="OpenLogs_Click"/>
                                    <Button Content="Export Diagnostics" Click="ExportDiagnostics_Click"/>
                                </StackPanel>
                                <TextBox x:Name="DiagnosticsBox" Height="120" Margin="0,10,0,0" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SmsSurface}"
                Padding="20,10"
                BorderBrush="{StaticResource SmsBorderGlow}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="4" Height="4" CornerRadius="2" Background="{StaticResource SmsAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="LogLine" Grid.Column="1" Text=""
                           Foreground="{StaticResource SmsForegroundDim}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
