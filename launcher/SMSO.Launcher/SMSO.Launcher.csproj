<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SMSO.Net\SMSO.Net.csproj" />
    <ProjectReference Include="..\SMSO.Bridge\SMSO.Bridge.csproj" />
    <ProjectReference Include="..\SMSO.Server\SMSO.Server.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>BSMSO.Launcher</AssemblyName>
    <Product>BSMSO</Product>
    <AssemblyTitle>BSMSO Launcher</AssemblyTitle>
    <ApplicationIcon>Assets\bsmso.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BSMSOClientLite)' == 'true'">
    <DefineConstants>$(DefineConstants);BSMSO_CLIENT_LITE</DefineConstants>
    <AssemblyTitle>BSMSO Launcher (Lite)</AssemblyTitle>
    <Product>BSMSO Lite</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SMSO.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\bsmso.ico" />
    <Content Include="Assets\bsmso-banner.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\levels.ntsc-u.json">
      <Link>assets\levels.ntsc-u.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\episode-names.ntsc-u.json">
      <Link>assets\episode-names.ntsc-u.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GCNTools" Version="1.0.2" />
  </ItemGroup>

</Project>
