<Application x:Class="SMSO.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:net="clr-namespace:SMSO.Net;assembly=SMSO.Net"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type net:CourseEntry}">
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource SmsForeground}"/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type net:EpisodeEntry}">
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource SmsForeground}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
