<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BSMSOClientLite)' == 'true'">
    <DefineConstants>$(DefineConstants);BSMSO_CLIENT_LITE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tall-character BodyAngleFree.prm override (Luigi / Nightendo / Waluigi / Wario). -->
    <EmbeddedResource Include="MarioPack\bodyanglefree2.prm"
                      LogicalName="SMSO.Net.MarioPack.bodyanglefree2.prm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SMSO.Tests" />
  </ItemGroup>

</Project>
